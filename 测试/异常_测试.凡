导入 "库/测试" 作为 测试模块

变量 记录 = []

函数 追加记录(字符串 文本)
    记录 = 追加(记录, 文本)
结束

函数 测试稍后执行顺序()
    记录 = []
    函数 执行()
        稍后 追加记录("第二")
        稍后 追加记录("第一")
    结束
    执行()
    测试模块.断言相等(记录, ["第一", "第二"])
结束

函数 测试崩溃和恢复()
    变量 结果 = 空
    函数 执行()
        稍后 函数()
            结果 = 恢复()
        结束
        崩溃了("失败")
    结束
    执行()
    测试模块.断言相等(结果.消息, "失败")
结束

函数 崩溃了只接受错误描述并生成错误对象()
    变量 拿到 = 空
    函数 执行()
        稍后 函数()
            拿到 = 恢复()
        结束
        崩溃了("自定义崩溃")
    结束
    执行()
    测试模块.断言相等(拿到.消息, "自定义崩溃")
    测试模块.断言相等(拿到.错误码, "")
    测试模块.断言为真(长度(拿到.调用栈) > 0)
结束

函数 测试错误对象成员访问()
    变量 e = 错误("磁盘满")
    测试模块.断言相等(e.消息, "磁盘满")
    测试模块.断言相等(e.码, "")
    测试模块.断言相等(e.错误码, "")
    测试模块.断言相等(e.原因, 空)
    测试模块.断言相等(e.调用栈, [])
    测试模块.断言为真(长度(e.追踪) > 0)
结束

函数 测试错误携带错误码与详情()
    变量 e = 错误("磁盘满", "E01", {"路径": "/x"})
    测试模块.断言相等(e.消息, "磁盘满")
    测试模块.断言相等(e.错误码, "E01")
    测试模块.断言相等(e.详情["路径"], "/x")
结束

函数 测试崩溃后恢复得到规范错误对象()
    变量 恢复到 = 空
    函数 执行()
        稍后 函数()
            恢复到 = 恢复()
        结束
        崩溃了("磁盘满")
    结束
    执行()
    测试模块.断言相等(恢复到.消息, "磁盘满")
    测试模块.断言为真(长度(恢复到.调用栈) > 0)
结束
