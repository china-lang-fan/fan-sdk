导入 "库/系统" 作为 系统
导入 "库/测试" 作为 测试模块

函数 测试类型名()
    测试模块.断言相等(系统.类型名(1), "integer")
    测试模块.断言相等(系统.类型名(1.5), "float")
    测试模块.断言相等(系统.类型名("凡"), "string")
    测试模块.断言相等(系统.类型名(真), "boolean")
    测试模块.断言相等(系统.类型名(空), "nil")
    测试模块.断言相等(系统.类型名([1, 2]), "array")
    测试模块.断言相等(系统.类型名({"a": 1}), "dict")
    测试模块.断言相等(系统.类型名(系统.构造错误("x")), "error")
结束

函数 测试截断()
    测试模块.断言相等(系统.截断(3.9), 3)
    测试模块.断言相等(系统.截断(-3.9), -3)
    测试模块.断言相等(系统.截断(3.0), 3)
结束

函数 测试编码点与字符互为逆操作()
    测试模块.断言相等(系统.编码点("A"), 65)
    测试模块.断言相等(系统.编码点("凡"), 20961)
    测试模块.断言相等(系统.字符(65), 'A')
    测试模块.断言相等(系统.字符(20961), '凡')
    测试模块.断言相等(系统.字符(系统.编码点("凡")), '凡')
结束

函数 测试长度()
    测试模块.断言相等(系统.长度("你好"), 2)
    测试模块.断言相等(系统.长度([1, 2, 3]), 3)
    测试模块.断言相等(系统.长度({"a": 1, "b": 2}), 2)
    测试模块.断言相等(系统.长度([]), 0)
结束

函数 测试追加返回新数组()
    变量 原数组 = [1, 2]
    测试模块.断言相等(系统.追加(原数组, 3), [1, 2, 3])
    测试模块.断言相等(系统.追加(原数组, 3, 4, 5), [1, 2, 3, 4, 5])
    测试模块.断言相等(原数组, [1, 2])
结束

函数 测试构造错误()
    变量 错误值 = 系统.构造错误("磁盘满")
    测试模块.断言相等(系统.类型名(错误值), "error")
    测试模块.断言相等(错误值.消息, "磁盘满")
结束

函数 测试失败经断言触发中断()
    测试模块.断言为真(真)
    测试模块.断言相等(1, 1)
    测试模块.断言不相等(1, 2)
    测试模块.断言为空(空)
结束
