导入 "库/动态库" 作为 动态库
导入 "库/测试" 作为 测试模块
导入 "库/系统" 作为 系统

# 内存读写：不依赖任何外部库，全平台稳定，验证句柄类型与封送链路。
函数 测试内存整数读写()
    变量 缓冲, 分配错误 = 动态库.分配内存(16)
    测试模块.断言相等(分配错误, 空)
    测试模块.断言相等(系统.类型名(缓冲), "handle")

    变量 写错误 = 动态库.写内存(缓冲, "整数", 12345)
    测试模块.断言相等(写错误, 空)
    变量 值, 读错误 = 动态库.读内存(缓冲, "整数")
    测试模块.断言相等(读错误, 空)
    测试模块.断言相等(值, 12345)

    变量 释放错误 = 动态库.释放(缓冲)
    测试模块.断言相等(释放错误, 空)
结束

函数 测试内存小数与字节读写()
    变量 缓冲, 分配错误 = 动态库.分配内存(16)
    测试模块.断言相等(分配错误, 空)

    变量 写小数错误 = 动态库.写内存(缓冲, "小数", 3.5)
    测试模块.断言相等(写小数错误, 空)
    变量 小数结果, 读小数错误 = 动态库.读内存(缓冲, "小数")
    测试模块.断言相等(读小数错误, 空)
    测试模块.断言相等(小数结果, 3.5)

    变量 写字节错误 = 动态库.写内存(缓冲, "字节", 200)
    测试模块.断言相等(写字节错误, 空)
    变量 字节结果, 读字节错误 = 动态库.读内存(缓冲, "字节")
    测试模块.断言相等(读字节错误, 空)
    测试模块.断言相等(字节结果, 200)

    测试模块.断言相等(动态库.释放(缓冲), 空)
结束

函数 测试C字符串往返()
    变量 文本缓冲, 转换错误 = 动态库.转C字符串("你好 fan")
    测试模块.断言相等(转换错误, 空)
    变量 文本, 读回错误 = 动态库.转字符串(文本缓冲)
    测试模块.断言相等(读回错误, 空)
    测试模块.断言相等(文本, "你好 fan")
    测试模块.断言相等(动态库.释放(文本缓冲), 空)
结束

函数 测试非法参数返回错误()
    变量 缓冲, 缓冲错误 = 动态库.分配内存(8)
    测试模块.断言相等(缓冲错误, 空)
    变量 无效值, 错误二 = 动态库.读内存(缓冲, "不存在的类型")
    测试模块.断言相等(错误二 != 空, 真)
    测试模块.断言相等(无效值, 空)
    测试模块.断言相等(动态库.释放(缓冲), 空)
结束

函数 测试加载不存在的库失败()
    变量 库句柄, 错误值 = 动态库.加载库("这个库一定不存在/虚拟路径/libnope.so")
    测试模块.断言相等(错误值 != 空, 真)
    测试模块.断言相等(库句柄, 空)
结束

# 加载系统 C 库并调用稳定函数。库名按平台不同；非 Linux 平台打开失败即安全跳过。
函数 测试调用系统库函数()
    变量 库句柄, 打开错误 = 动态库.加载库("libc.so.6")
    如果 打开错误 != 空 那么
        返回
    结束

    变量 绝对值函数, 符号错误 = 动态库.取函数(库句柄, "abs", "整数", "整数")
    测试模块.断言相等(符号错误, 空)
    变量 结果, 调用错误 = 动态库.调用(绝对值函数, -42)
    测试模块.断言相等(调用错误, 空)
    测试模块.断言相等(结果, 42)

    变量 长度函数, 长度符号错误 = 动态库.取函数(库句柄, "strlen", "整数", "句柄")
    测试模块.断言相等(长度符号错误, 空)
    变量 文本句柄, 文本错误 = 动态库.转C字符串("hello")
    测试模块.断言相等(文本错误, 空)
    变量 长度, 长度调用错误 = 动态库.调用(长度函数, 文本句柄)
    测试模块.断言相等(长度调用错误, 空)
    测试模块.断言相等(长度, 5)
    测试模块.断言相等(动态库.释放(文本句柄), 空)
结束
