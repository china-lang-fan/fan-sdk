公开 函数 转字符串(任意 值)
    判断 系统.类型名(值)
        为 "string"
            返回 值
        为 "integer"
            返回 整数转文本(值)
        为 "float"
            返回 小数转文本(值)
        为 "boolean"
            如果 值 那么
                返回 "真"
            结束
            返回 "假"
        为 "nil"
            返回 "空"
        为 "error"
            返回 值.消息
        为 "byte"
            返回 整数转文本(值)
        为 "char"
            返回 值
    结束
    返回 系统.类型名(值)
结束

公开 函数 转整数(任意 值)
    判断 系统.类型名(值)
        为 "integer"
            返回 值
        为 "float"
            返回 系统.截断(值)
        为 "boolean"
            如果 值 那么
                返回 1
            结束
            返回 0
        为 "string"
            变量 结果, 错误值 = 解析整数值(值)
            返回 结果
    结束
    系统.失败("无法转换为整数：" + 系统.类型名(值))
    返回 0
结束

公开 函数 转小数(任意 值)
    判断 系统.类型名(值)
        为 "integer"
            返回 值 + 0.0
        为 "float"
            返回 值
        为 "boolean"
            如果 值 那么
                返回 1.0
            结束
            返回 0.0
        为 "string"
            变量 结果, 错误值 = 解析小数值(值)
            返回 结果
    结束
    系统.失败("无法转换为小数：" + 系统.类型名(值))
    返回 0.0
结束

公开 函数 转布尔(任意 值)
    判断 系统.类型名(值)
        为 "boolean"
            返回 值
        为 "integer"
            返回 值 != 0
        为 "float"
            返回 值 != 0.0
        为 "string"
            变量 结果, 错误值 = 解析布尔值(值)
            如果 错误值 == 空 那么
                返回 结果
            结束
            返回 值 != ""
        为 "nil"
            返回 假
        为 "array", "dict"
            返回 系统.长度(值) > 0
    结束
    返回 真
结束

